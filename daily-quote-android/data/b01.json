[
{ "text": "가는 말이 고와야 오는 말이 곱다.", "author": "한국 속담" },
{ "text": "가랑비에 옷 젖는 줄 모른다.", "author": "한국 속담" },
{ "text": "가재는 게 편이다.", "author": "한국 속담" },
{ "text": "갈수록 태산.", "author": "한국 속담" },
{ "text": "값싼 것이 비지떡.", "author": "한국 속담" },
{ "text": "강 건너 불구경.", "author": "한국 속담" },
{ "text": "개같이 벌어 정승같이 쓴다.", "author": "한국 속담" },
{ "text": "개똥도 약에 쓰려면 없다.", "author": "한국 속담" },
{ "text": "개천에서 용 난다.", "author": "한국 속담" },
{ "text": "걱정도 팔자다.", "author": "한국 속담" },
{ "text": "겉 다르고 속 다르다.", "author": "한국 속담" },
{ "text": "계란으로 바위 치기.", "author": "한국 속담" },
{ "text": "고래 싸움에 새우 등 터진다.", "author": "한국 속담" },
{ "text": "고생 끝에 낙이 온다.", "author": "한국 속담" },
{ "text": "고양이 목에 방울 달기.", "author": "한국 속담" },
{ "text": "골치 아픈 일은 남에게 미루라.", "author": "한국 속담" },
{ "text": "공든 탑이 무너지랴.", "author": "한국 속담" },
{ "text": "굼벵이도 구르는 재주가 있다.", "author": "한국 속담" },
{ "text": "귀머거리 삼 년이면 저절로 듣는다.", "author": "한국 속담" },
{ "text": "그 아버지에 그 아들.", "author": "한국 속담" },
{ "text": "그림의 떡.", "author": "한국 속담" },
{ "text": "길고 짧은 것은 대어 봐야 안다.", "author": "한국 속담" },
{ "text": "김칫국부터 마신다.", "author": "한국 속담" },
{ "text": "꿩 먹고 알 먹기.", "author": "한국 속담" },
{ "text": "나무는 옮겨 심으면 죽는다.", "author": "한국 속담" },
{ "text": "남의 떡이 커 보인다.", "author": "한국 속담" },
{ "text": "남의 잔치에 감 놓아라 배 놓아라.", "author": "한국 속담" },
{ "text": "낫 놓고 기역 자도 모른다.", "author": "한국 속담" },
{ "text": "낮말은 새가 듣고 밤말은 쥐가 듣는다.", "author": "한국 속담" },
{ "text": "내 코가 석 자.", "author": "한국 속담" },
{ "text": "누워서 떡 먹기.", "author": "한국 속담" },
{ "text": "눈 가리고 아웅.", "author": "한국 속담" },
{ "text": "눈에 가시.", "author": "한국 속담" },
{ "text": "다 된 죽에 코 빠졌다.", "author": "한국 속담" },
{ "text": "닭 쫓던 개 지붕 쳐다보듯.", "author": "한국 속담" },
{ "text": "도둑이 제 발 저린다.", "author": "한국 속담" },
{ "text": "돌다리도 두들겨 보고 건너라.", "author": "한국 속담" },
{ "text": "둘이 먹다가 하나가 죽어도 모른다.", "author": "한국 속담" },
{ "text": "등잔 밑이 어둡다.", "author": "한국 속담" },
{ "text": "땅 짚고 헤엄치기.", "author": "한국 속담" },
{ "text": "떡 본 김에 제사 지낸다.", "author": "한국 속담" },
{ "text": "말 한마디에 천 냥 빚을 갚는다.", "author": "한국 속담" },
{ "text": "망둥이가 뛰면 꼴뚜기도 뛴다.", "author": "한국 속담" },
{ "text": "매도 먼저 맞는 놈이 낫다.", "author": "한국 속담" },
{ "text": "목구멍이 포도청.", "author": "한국 속담" },
{ "text": "물에 빠지면 지푸라기라도 잡는다.", "author": "한국 속담" },
{ "text": "믿는 도끼에 발등 찍힌다.", "author": "한국 속담" },
{ "text": "밑 빠진 독에 물 붓기.", "author": "한국 속담" },
{ "text": "바늘 도둑이 소도둑 된다.", "author": "한국 속담" },
{ "text": "발 없는 말이 천 리 간다.", "author": "한국 속담" },
{ "text": "배보다 배꼽이 더 크다.", "author": "한국 속담" },
{ "text": "백지장도 맞들면 낫다.", "author": "한국 속담" },
{ "text": "벼는 익을수록 고개를 숙인다.", "author": "한국 속담" },
{ "text": "병 주고 약 준다.", "author": "한국 속담" },
{ "text": "보기 좋은 떡이 먹기도 좋다.", "author": "한국 속담" },
{ "text": "부뚜막의 소금도 집어넣어야 짜다.", "author": "한국 속담" },
{ "text": "북 치고 장구 친다.", "author": "한국 속담" },
{ "text": "빈 수레가 요란하다.", "author": "한국 속담" },
{ "text": "빛 좋은 개살구.", "author": "한국 속담" },
{ "text": "사공이 많으면 배가 산으로 간다.", "author": "한국 속담" },
{ "text": "사람은 죽으면 이름을 남기고 범은 죽으면 가죽을 남긴다.", "author": "한국 속담" },
{ "text": "사람 팔자는 시간문제.", "author": "한국 속담" },
{ "text": "산 넘어 산.", "author": "한국 속담" },
{ "text": "산 입에 거미줄 치랴.", "author": "한국 속담" },
{ "text": "새 발의 피.", "author": "한국 속담" },
{ "text": "서당 개 삼 년에 풍월을 읊는다.", "author": "한국 속담" },
{ "text": "세 살 버릇 여든까지 간다.", "author": "한국 속담" },
{ "text": "소 잃고 외양간 고친다.", "author": "한국 속담" },
{ "text": "소문난 잔치에 먹을 것 없다.", "author": "한국 속담" },
{ "text": "손바닥으로 하늘을 가리려 한다.", "author": "한국 속담" },
{ "text": "송충이는 솔잎을 먹어야 한다.", "author": "한국 속담" },
{ "text": "쇠귀에 경 읽기.", "author": "한국 속담" },
{ "text": "쇠뿔도 단김에 빼랴.", "author": "한국 속담" },
{ "text": "수박 겉 핥기.", "author": "한국 속담" },
{ "text": "수탉이 울어야 날이 샌다.", "author": "한국 속담" },
{ "text": "시작이 반이다.", "author": "한국 속담" },
{ "text": "식은 죽 먹기.", "author": "한국 속담" },
{ "text": "신주 모시듯 한다.", "author": "한국 속담" },
{ "text": "아는 길도 물어 가라.", "author": "한국 속담" },
{ "text": "아니 땐 굴뚝에 연기 날까.", "author": "한국 속담" },
{ "text": "앓던 이 빠진 것 같다.", "author": "한국 속담" },
{ "text": "약방에 감초.", "author": "한국 속담" },
{ "text": "양지가 음지 되고 음지가 양지 된다.", "author": "한국 속담" },
{ "text": "어물전 망신은 꼴뚜기가 시킨다.", "author": "한국 속담" },
{ "text": "언 발에 오줌 누기.", "author": "한국 속담" },
{ "text": "엎친 데 덮친 격.", "author": "한국 속담" },
{ "text": "여우가 죽으니까 토끼가 슬퍼한다.", "author": "한국 속담" },
{ "text": "열 번 찍어 안 넘어가는 나무 없다.", "author": "한국 속담" },
{ "text": "염불에는 관심 없고 잿밥에만 관심이 있다.", "author": "한국 속담" },
{ "text": "오르지 못할 나무는 쳐다보지도 마라.", "author": "한국 속담" },
{ "text": "옥에 티.", "author": "한국 속담" },
{ "text": "우물 안 개구리.", "author": "한국 속담" },
{ "text": "우물에 가 숭늉 찾는다.", "author": "한국 속담" },
{ "text": "원숭이도 나무에서 떨어진다.", "author": "한국 속담" },
{ "text": "윗물이 맑아야 아랫물이 맑다.", "author": "한국 속담" },
{ "text": "자라 보고 놀란 가슴 솥뚜껑 보고 놀란다.", "author": "한국 속담" },
{ "text": "재수 없는 놈은 뒤로 자빠져도 코가 깨진다.", "author": "한국 속담" },
{ "text": "쥐구멍에도 볕 들 날 있다.", "author": "한국 속담" },
{ "text": "지렁이도 밟으면 꿈틀한다.", "author": "한국 속담" },
{ "text": "집 떠나면 고생이다.", "author": "한국 속담" }
]
