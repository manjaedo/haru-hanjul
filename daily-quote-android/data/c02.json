[
 {
  "text": "가게 기둥에 입춘",
  "author": "한국 속담"
 },
 {
  "text": "가까운 이웃이 먼 친척보다 낫다",
  "author": "한국 속담"
 },
 {
  "text": "가난 구제는 나라님도 못한다",
  "author": "한국 속담"
 },
 {
  "text": "가난이 병보다 무섭다",
  "author": "한국 속담",
  "note": "가난한 삶은 몹시 괴로움"
 },
 {
  "text": "가난한 집 제사 돌아오듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "가는 날이 장날이다",
  "author": "한국 속담"
 },
 {
  "text": "가는 방망이, 오는 홍두깨",
  "author": "한국 속담"
 },
 {
  "text": "가는 정이 있어야 오는 정이 있다",
  "author": "한국 속담"
 },
 {
  "text": "가랑잎에 불붙듯",
  "author": "한국 속담"
 },
 {
  "text": "가랑잎으로 눈 가린다",
  "author": "한국 속담"
 },
 {
  "text": "가랑잎이 솔잎더러 바스락거린다고 한다",
  "author": "한국 속담"
 },
 {
  "text": "가뭄에 콩 나듯",
  "author": "한국 속담"
 },
 {
  "text": "가을 중 싸대듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "가지 많은 나무 바람 잘 날 없다",
  "author": "한국 속담"
 },
 {
  "text": "감나무 아래서 갓끈 메지말고, 오이밭에서 신 끈 메지마라.",
  "author": "한국 속담"
 },
 {
  "text": "강 건너 불 보듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "강철이 가을이다",
  "author": "한국 속담"
 },
 {
  "text": "강철이 간 데는 가을도 봄(이라)",
  "author": "한국 속담"
 },
 {
  "text": "같은 값이면 다홍치마",
  "author": "한국 속담"
 },
 {
  "text": "같은 떡도 남의 것이 커 보인다",
  "author": "한국 속담"
 },
 {
  "text": "같은 말이라도 아 다르고 어 다르다",
  "author": "한국 속담"
 },
 {
  "text": "개같이 벌어서 정승같이 쓰랬다",
  "author": "한국 속담"
 },
 {
  "text": "개똥이 무서워 피하나, 더러워 피하지",
  "author": "한국 속담"
 },
 {
  "text": "개미 쳇바퀴 돌듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "개밥에 도토리",
  "author": "한국 속담"
 },
 {
  "text": "개버릇 남 못 준다",
  "author": "한국 속담"
 },
 {
  "text": "개천에서 용 났다",
  "author": "한국 속담"
 },
 {
  "text": "개울 치고 가재 잡는다",
  "author": "한국 속담"
 },
 {
  "text": "개팔자가 상팔자라",
  "author": "한국 속담"
 },
 {
  "text": "거지 발싸개 같다",
  "author": "한국 속담"
 },
 {
  "text": "게눈 감추듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "계란에도 뼈가 있다",
  "author": "한국 속담"
 },
 {
  "text": "고기는 씹어야 맛이고 말은 해야 맛이다",
  "author": "한국 속담"
 },
 {
  "text": "고기도 저 놀던 물이 좋다",
  "author": "한국 속담"
 },
 {
  "text": "고기도 먹어 본 사람이 잘 먹는다",
  "author": "한국 속담"
 },
 {
  "text": "고양이 쥐 생각한다",
  "author": "한국 속담"
 },
 {
  "text": "고양이보고 반찬가게 지켜 달란다",
  "author": "한국 속담"
 },
 {
  "text": "과부 사정은 과부가 안다",
  "author": "한국 속담"
 },
 {
  "text": "광에서 인심 난다",
  "author": "한국 속담"
 },
 {
  "text": "구더기 무서워 장 못 담글까",
  "author": "한국 속담"
 },
 {
  "text": "구렁이 담 넘어가듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "구르는 돌은 이끼가 끼지 않는다",
  "author": "한국 속담"
 },
 {
  "text": "구멍은 깎을수록 더 커진다",
  "author": "한국 속담"
 },
 {
  "text": "구슬이 서 말이라도 꿰어야 보배라",
  "author": "한국 속담"
 },
 {
  "text": "굼벵이도 밟으면 꿈틀한다",
  "author": "한국 속담"
 },
 {
  "text": "궁하면 통한다",
  "author": "한국 속담"
 },
 {
  "text": "굽은 나무가 선산을 지킨다",
  "author": "한국 속담"
 },
 {
  "text": "귀머거리 삼 년 벙어리 삼 년이라",
  "author": "한국 속담"
 },
 {
  "text": "귀에 걸면 귀고리, 코에 걸면 코걸이",
  "author": "한국 속담"
 },
 {
  "text": "그림의 떡이다",
  "author": "한국 속담"
 },
 {
  "text": "그물에 든 고기",
  "author": "한국 속담"
 },
 {
  "text": "그 아비에 그 자식이다",
  "author": "한국 속담"
 },
 {
  "text": "긁어 부스럼을 만든다",
  "author": "한국 속담"
 },
 {
  "text": "금강산도 식후경이라",
  "author": "한국 속담"
 },
 {
  "text": "급하다고 바늘허리에 실 매어 쓸까",
  "author": "한국 속담"
 },
 {
  "text": "기는 놈 위에 나는 놈이 있다",
  "author": "한국 속담"
 },
 {
  "text": "기둥을 치면 대들보가 운다",
  "author": "한국 속담"
 },
 {
  "text": "기름 먹인 가죽이 부드럽다",
  "author": "한국 속담"
 },
 {
  "text": "길고 짧은 것은 대어 보아야 안다",
  "author": "한국 속담"
 },
 {
  "text": "길러 준 개 주인 문다",
  "author": "한국 속담"
 },
 {
  "text": "길이 아니면 가지를 말고 말이 아니면 듣지를 말라",
  "author": "한국 속담"
 },
 {
  "text": "까마귀가 검기로 속도 검으랴",
  "author": "한국 속담"
 },
 {
  "text": "꼬리가 길면 밟힌다",
  "author": "한국 속담"
 },
 {
  "text": "꾸어다 놓은 보릿자루",
  "author": "한국 속담"
 },
 {
  "text": "꿀 먹은 벙어리다",
  "author": "한국 속담"
 },
 {
  "text": "꿈보다 해몽이 낫다",
  "author": "한국 속담"
 },
 {
  "text": "꿩 대신 닭이다",
  "author": "한국 속담"
 },
 {
  "text": "꿩 먹고 알 먹는다",
  "author": "한국 속담"
 },
 {
  "text": "꿩 잡는 것이 매다",
  "author": "한국 속담"
 },
 {
  "text": "끝 부러진 송곳",
  "author": "한국 속담"
 },
 {
  "text": "개 눈에는 똥만 보인다",
  "author": "한국 속담"
 },
 {
  "text": "개같이 벌어서 정승같이 쓴다",
  "author": "한국 속담"
 },
 {
  "text": "개는 잘 짖는 다고 좋은 개가 아니다",
  "author": "한국 속담"
 },
 {
  "text": "개도 닷새만 되면 주인을 안다",
  "author": "한국 속담"
 },
 {
  "text": "개똥도 약에 쓰려니 없다.",
  "author": "한국 속담"
 },
 {
  "text": "개미 구멍이 둑을 무너뜨릴 수도 있다",
  "author": "한국 속담"
 },
 {
  "text": "게으른 귀신은 국도 못 얻어먹는다.",
  "author": "한국 속담"
 },
 {
  "text": "고슴도치에 놀란 호랑이 밤송이 보고 절한다",
  "author": "한국 속담"
 },
 {
  "text": "고양이 목에 방울 단다",
  "author": "한국 속담"
 },
 {
  "text": "고양이 죽은데 쥐 눈물만큼",
  "author": "한국 속담"
 },
 {
  "text": "고양이가 발톱을 감춘다",
  "author": "한국 속담"
 },
 {
  "text": "금강산도 식후경이다.",
  "author": "한국 속담"
 },
 {
  "text": "나간 놈의 집구석 같다",
  "author": "한국 속담",
  "note": "어수선하고 어지러움"
 },
 {
  "text": "나루 건너 배 타기",
  "author": "한국 속담",
  "note": "무슨 일에나 순서가 있어 건너뛰어서는 할 수 없음을 비유적으로 이르는 말."
 },
 {
  "text": "나 먹자니 싫고 남 주자니 아깝다",
  "author": "한국 속담",
  "note": "자기가 싫어하면서도 남에게 주기는 더 아까워하는 인색한 사람을 가리켜 하는 말."
 },
 {
  "text": "나 못 먹을 밥이라고 재 뿌린다",
  "author": "한국 속담",
  "note": "자기가 못 가질 바에는 남도 가지지 못하게 망쳐 버리는 심술 사나움을 뜻함."
 },
 {
  "text": "나무에 오르라 하고 흔든다",
  "author": "한국 속담",
  "note": "남을 꾀어 어려운 처지에 빠뜨림"
 },
 {
  "text": "나중 난 뿔이 우뚝하다",
  "author": "한국 속담",
  "note": "후배가 선배보다 나음."
 },
 {
  "text": "나중 보자는 사람 무섭지 않다",
  "author": "한국 속담",
  "note": "어떤 일에 대해 나중에 어떻게 하겠다고 미리 말하는 것은 아무 소용이 없다는 말."
 },
 {
  "text": "남의 장단에 춤을 춘다",
  "author": "한국 속담",
  "note": "무슨 일을 할 때에는 자기 잘 할 수 있는 분야를 알고서 자립적으로 해야 한다는 뜻."
 },
 {
  "text": "남의 제사에 감 놓아라 배 놓아라 한다",
  "author": "한국 속담",
  "note": "자기와는 관계도 없는 일에 참견하고 공연히 간섭하지 말라는 뜻."
 },
 {
  "text": "남이야 전봇대로 이를 쑤시건 말건",
  "author": "한국 속담",
  "note": "남의 일에는 상관 말라는 뜻."
 },
 {
  "text": "내가 할 말을 사돈이 한다",
  "author": "한국 속담",
  "note": "자기가 할 말을 상대방이 미리 선수친다는 말."
 },
 {
  "text": "내 코가 석 자다",
  "author": "한국 속담",
  "note": "내 사정도 급하니 남의 사정 봐줄 여유가 없다는 뜻."
 },
 {
  "text": "냉수 먹고 이 쑤신다",
  "author": "한국 속담",
  "note": "실속은 없으면서 겉으로만 있는 척한다는 뜻."
 },
 {
  "text": "녹비에 가로 왈",
  "author": "한국 속담"
 },
 {
  "text": "누울 자리 봐 가며 발 뻗는다",
  "author": "한국 속담",
  "note": "무슨 일을 할 때 미리 살펴 다가올 결과를 생각해 가면서 일을 시작한다는 말."
 },
 {
  "text": "누워 떡 먹기",
  "author": "한국 속담",
  "note": "일을 아주 손쉽게 할 수 있을 때 쓰는 말."
 },
 {
  "text": "누워서 침 뱉기",
  "author": "한국 속담",
  "note": "남을 해치려다 자기가 도리어 해를 입는다는 말."
 },
 {
  "text": "누이 좋고 매부 좋다",
  "author": "한국 속담",
  "note": "어떤 한 가지 일로 두 배의 효과를 보거나 서로에게 이익이 돌아갈 때 쓰는 말."
 },
 {
  "text": "눈 가리고 아웅 한다",
  "author": "한국 속담",
  "note": "속이 훤히 들여다보이는 얕은 꾀로 남을 속이려 한다는 뜻."
 },
 {
  "text": "눈 감으면 코 베어갈 세상이다",
  "author": "한국 속담",
  "note": "인정사납고 험악한 세상 인심을 빗대어 하는 말."
 },
 {
  "text": "느릿느릿 걸어도 황소 걸음",
  "author": "한국 속담",
  "note": "보기에는 느리지만 꾸준하고 믿음직스러우며, 실속이 있다는 말."
 },
 {
  "text": "늦게 배운 도둑이 날 새는 줄 모른다",
  "author": "한국 속담",
  "note": "어떤 일에 늦게서야 재미를 붙이게 되면 몹시 열중한다는 뜻."
 },
 {
  "text": "다 된 밥에 재 뿌리기",
  "author": "한국 속담"
 },
 {
  "text": "다람쥐 쳇바퀴 돌듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "단단한 땅에 물이 고인다",
  "author": "한국 속담"
 },
 {
  "text": "달걀도 굴러가다 서는 모가 있다",
  "author": "한국 속담",
  "note": "어떤 일이든 끝날 때가 있다는 말."
 },
 {
  "text": "달리는 말에 채찍질한다",
  "author": "한국 속담"
 },
 {
  "text": "달면 삼키고 쓰면 뱉는다",
  "author": "한국 속담"
 },
 {
  "text": "당장 먹기엔 곶감이 달다",
  "author": "한국 속담"
 },
 {
  "text": "달밤에 삿갓 쓰고 나온다",
  "author": "한국 속담"
 },
 {
  "text": "닭 소 보듯 소 닭 보듯",
  "author": "한국 속담"
 },
 {
  "text": "닭 잡아먹고 오리발 내놓는다",
  "author": "한국 속담"
 },
 {
  "text": "닭 쫓던 개 지붕만 쳐다본다",
  "author": "한국 속담"
 },
 {
  "text": "도끼로 제 발등 찍는다",
  "author": "한국 속담"
 },
 {
  "text": "도둑을 맞을라니 개도 아니 짖는다",
  "author": "한국 속담"
 },
 {
  "text": "도둑질도 손발이 맞아야 한다",
  "author": "한국 속담"
 },
 {
  "text": "도랑치고 가재잡는다",
  "author": "한국 속담"
 },
 {
  "text": "동냥은 아니 주고 쪽박만 깬다",
  "author": "한국 속담"
 },
 {
  "text": "동에 번쩍 서에 번쩍",
  "author": "한국 속담"
 },
 {
  "text": "되로 주고 말로 받는다",
  "author": "한국 속담"
 },
 {
  "text": "될 성 부른 나무는 떡잎부터 안다",
  "author": "한국 속담"
 },
 {
  "text": "두꺼비 파리 잡아먹듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "들으면 병이요, 안 들으면 약이다",
  "author": "한국 속담"
 },
 {
  "text": "등을 스다듬어준 강아지 발등 문다",
  "author": "한국 속담"
 },
 {
  "text": "딸이 셋이면 대문을 열어놓고 잠을 잔다.",
  "author": "한국 속담"
 },
 {
  "text": "딸 삼형제 시집보내면 도둑놈도 안 든다.",
  "author": "한국 속담"
 },
 {
  "text": "떡 줄 놈은 생각도 않는데 김칫국부터 마신다",
  "author": "한국 속담"
 },
 {
  "text": "똥 누러 갈 때 마음 다르고, 올 적 마음 다르다",
  "author": "한국 속담"
 },
 {
  "text": "똥 묻은 개가 겨 묻은 개 나무란다",
  "author": "한국 속담"
 },
 {
  "text": "똥이 무서워 피하나 더러워 피하지",
  "author": "한국 속담"
 },
 {
  "text": "도둑도 제 말하면 온다.",
  "author": "한국 속담"
 },
 {
  "text": "돼지 발톱에 봉숭아 들이기",
  "author": "한국 속담"
 },
 {
  "text": "똥 묻은 개가 겨 묻은 개를 나무란다",
  "author": "한국 속담"
 },
 {
  "text": "마누라가 이쁘면 처가말뚝을 보고도 절을 한다.",
  "author": "한국 속담"
 },
 {
  "text": "마파람에 게눈 감추듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "말은 나면 제주도로 보내고, 사람은 나면 서울로 보내라",
  "author": "한국 속담"
 },
 {
  "text": "말 안 하면 귀신도 모른다",
  "author": "한국 속담"
 },
 {
  "text": "말은 해야 맛이고 고기는 씹어야 맛이라",
  "author": "한국 속담"
 },
 {
  "text": "매 끝에 정 든다",
  "author": "한국 속담"
 },
 {
  "text": "먼 사촌보다 가까운 이웃이 낫다",
  "author": "한국 속담"
 },
 {
  "text": "모난 돌이 정 맞는다",
  "author": "한국 속담"
 },
 {
  "text": "모로 가도 서울만 가면 된다",
  "author": "한국 속담"
 },
 {
  "text": "목구멍이 포도청이다",
  "author": "한국 속담"
 },
 {
  "text": "못된 송아지 엉덩이에 뿔 난다",
  "author": "한국 속담"
 },
 {
  "text": "못 먹는 감 찔러나 본다",
  "author": "한국 속담"
 },
 {
  "text": "무소식이 희소식이다",
  "author": "한국 속담"
 },
 {
  "text": "무자식 상팔자",
  "author": "한국 속담"
 },
 {
  "text": "물에 빠진 사람 건져 놓으니까 봇짐 내놓으라 한다",
  "author": "한국 속담",
  "note": "남에게 은혜를 입고서 도리어 그 사람을 원망할 때 쓰는 말."
 },
 {
  "text": "미꾸라지 용 됐다",
  "author": "한국 속담"
 },
 {
  "text": "미꾸라지 한 마리가 온 웅덩이를 흐린다",
  "author": "한국 속담"
 },
 {
  "text": "미운 놈 떡 하나 더 준다",
  "author": "한국 속담"
 },
 {
  "text": "말못하는 짐승이 사람보다 낫다.",
  "author": "한국 속담"
 },
 {
  "text": "바늘 가는 데 실 간다",
  "author": "한국 속담"
 },
 {
  "text": "밥 먹을 때는 개도 안 건든다",
  "author": "한국 속담"
 },
 {
  "text": "배 먹고 이 닦기",
  "author": "한국 속담"
 },
 {
  "text": "뱁새가 황새 걸음을 걸으면 가랑이가 찢어진다",
  "author": "한국 속담"
 },
 {
  "text": "번갯불에 콩 볶아 먹는다",
  "author": "한국 속담"
 },
 {
  "text": "범 아가리에 날고기 넣은 셈",
  "author": "한국 속담"
 },
 {
  "text": "범 없는 골에서는 토끼가 왕노릇 한다",
  "author": "한국 속담"
 },
 {
  "text": "범에게 물려가도 정신을 차려야 산다",
  "author": "한국 속담"
 },
 {
  "text": "법은 멀고 주먹은 가깝다",
  "author": "한국 속담"
 },
 {
  "text": "벙어리 냉가슴 앓듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "복날 개 패듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "봄눈 녹듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "봄볕은 며느리를 쬐이고 가을볕은 딸을 쬐인다",
  "author": "한국 속담"
 },
 {
  "text": "부처님 가운데 토막 같다",
  "author": "한국 속담"
 },
 {
  "text": "불난 집에 부채질 한다",
  "author": "한국 속담"
 },
 {
  "text": "비는데는 무쇠도 녹는다",
  "author": "한국 속담"
 },
 {
  "text": "비 온 뒤에 땅이 굳어진다",
  "author": "한국 속담"
 },
 {
  "text": "배부른 고양이는 쥐를 잡지 않는다",
  "author": "한국 속담"
 },
 {
  "text": "뱁새가 황새(를) 따라간다",
  "author": "한국 속담"
 },
 {
  "text": "뱁새가 황새를 따라가단 가랭이가 찢어진다.",
  "author": "한국 속담"
 },
 {
  "text": "부뚜막의 소금도 넣어야 짜다.",
  "author": "한국 속담"
 },
 {
  "text": "빈대 잡으려 초가삼산 태운다",
  "author": "한국 속담"
 },
 {
  "text": "사공이 많으면 배가 산으로 올라간다",
  "author": "한국 속담"
 },
 {
  "text": "사돈네 남의 말 한다",
  "author": "한국 속담"
 },
 {
  "text": "사돈 집과 뒷간은 멀수록 좋다",
  "author": "한국 속담"
 },
 {
  "text": "사또 떠난 뒤에 나팔 분다",
  "author": "한국 속담"
 },
 {
  "text": "사람은 죽어서 이름을 남기고, 호랑이는 죽어서 가죽을 남긴다",
  "author": "한국 속담"
 },
 {
  "text": "사위는 백년 손이요, 며느리는 종신 식구라",
  "author": "한국 속담"
 },
 {
  "text": "사서삼경을 다 읽어도 누울 와자가 제일",
  "author": "한국 속담"
 },
 {
  "text": "사촌이 땅을 사면 배가 아프다",
  "author": "한국 속담"
 },
 {
  "text": "산 사람의 목구멍에 거미줄 치랴",
  "author": "한국 속담"
 },
 {
  "text": "산이 울어 쥐 한 마리",
  "author": "한국 속담"
 },
 {
  "text": "살얼음을 밟는 것 같다",
  "author": "한국 속담"
 },
 {
  "text": "선무당이 사람 잡는다",
  "author": "한국 속담"
 },
 {
  "text": "세 살 적 버릇 여든까지 간다",
  "author": "한국 속담"
 },
 {
  "text": "세월이 약이다",
  "author": "한국 속담"
 },
 {
  "text": "소경이 개천을 나무란다",
  "author": "한국 속담"
 },
 {
  "text": "소경 제 닭 잡아먹기",
  "author": "한국 속담"
 },
 {
  "text": "쇠뿔은 단 김에 빼라",
  "author": "한국 속담"
 },
 {
  "text": "숭어가 뛰니까 망둥이도 뛴다",
  "author": "한국 속담"
 },
 {
  "text": "신선놀음에 도끼자루 썩는 줄 모른다",
  "author": "한국 속담"
 },
 {
  "text": "십 년이면 강산도 변한다",
  "author": "한국 속담"
 },
 {
  "text": "싸움은 말리고 흥정은 붙이랬다",
  "author": "한국 속담"
 },
 {
  "text": "싼 게 비지떡, 싼 게 갈치자반",
  "author": "한국 속담"
 },
 {
  "text": "서당개 3년이면 풍월을 읊는다",
  "author": "한국 속담"
 },
 {
  "text": "세살 버릇이 여든간다.",
  "author": "한국 속담"
 },
 {
  "text": "송충이는 솔잎을 먹어야 산다.",
  "author": "한국 속담"
 },
 {
  "text": "수염이 석 자라도 먹어야 양반이다.",
  "author": "한국 속담"
 },
 {
  "text": "아무리 바빠도 바늘허리 매어 쓰지는 못한다",
  "author": "한국 속담"
 },
 {
  "text": "아이 보는 데서는 찬물도 못 마신다",
  "author": "한국 속담"
 },
 {
  "text": "안 되는 사람은 뒤로 넘어져도 코가 깨진다",
  "author": "한국 속담"
 },
 {
  "text": "앉은 자리에 풀도 안 나겠다",
  "author": "한국 속담"
 },
 {
  "text": "암탉이 울면 집안이 망한다",
  "author": "한국 속담"
 },
 {
  "text": "앞집 처녀 믿다가 장가 못 간다",
  "author": "한국 속담"
 },
 {
  "text": "약방의 감초",
  "author": "한국 속담"
 },
 {
  "text": "엎드려 절 받기",
  "author": "한국 속담"
 },
 {
  "text": "엎어진 김에 쉬어 간다",
  "author": "한국 속담"
 },
 {
  "text": "여름비는 더워야 오고 가을비는 추워야 온다",
  "author": "한국 속담"
 },
 {
  "text": "여자 셋이 모이면 접시가 깨진다",
  "author": "한국 속담"
 },
 {
  "text": "열 길 물속은 알아도 한 길 사람속은 모른다.",
  "author": "한국 속담"
 },
 {
  "text": "열두 가지 재주 가진 놈, 저녁거리가 없다",
  "author": "한국 속담"
 },
 {
  "text": "열 손가락을 깨물어서 안 아픈 손가락 없다",
  "author": "한국 속담"
 },
 {
  "text": "염불에는 마음이 없고 잿밥에만 마음이 있다",
  "author": "한국 속담"
 },
 {
  "text": "엿장수 마음대로",
  "author": "한국 속담"
 },
 {
  "text": "오는 정이 있어야 가는 정이 있다",
  "author": "한국 속담"
 },
 {
  "text": "오르지 못할 나무는 쳐다보지도 말라",
  "author": "한국 속담"
 },
 {
  "text": "용 꼬리가 되는 것보다 뱀 대가리가 되는 것이 낫다",
  "author": "한국 속담"
 },
 {
  "text": "우는 아이 젖 준다",
  "author": "한국 속담"
 },
 {
  "text": "우물에 가 숭늉 찾겠다",
  "author": "한국 속담"
 },
 {
  "text": "우물을 파도 한 우물을 파라",
  "author": "한국 속담"
 },
 {
  "text": "웃는 낯에 침 뱉으랴",
  "author": "한국 속담"
 },
 {
  "text": "윗물이 맑아야 아랫물도 맑다",
  "author": "한국 속담"
 },
 {
  "text": "원님 덕에 나팔 분다",
  "author": "한국 속담"
 },
 {
  "text": "원수는 외나무다리에서 만난다",
  "author": "한국 속담"
 },
 {
  "text": "이가 없으면 잇몸으로 산다",
  "author": "한국 속담"
 },
 {
  "text": "임도 보고 뽕도 딴다",
  "author": "한국 속담"
 },
 {
  "text": "입술에 침이나 바르지",
  "author": "한국 속담"
 },
 {
  "text": "입은 비뚤어져도 말은 바로 해라",
  "author": "한국 속담"
 },
 {
  "text": "입추의 여지가 없다",
  "author": "한국 속담"
 },
 {
  "text": "우물가에서 소금달라 한다.",
  "author": "한국 속담"
 },
 {
  "text": "자라 보고 놀란 가슴, 솥뚜껑 보고도 놀란다",
  "author": "한국 속담"
 },
 {
  "text": "자식 겉 낳지 속 못 낳는다",
  "author": "한국 속담"
 },
 {
  "text": "작은 고추가 더 맵다",
  "author": "한국 속담"
 },
 {
  "text": "잘 되면 제 탓, 안 되면 조상 탓",
  "author": "한국 속담"
 },
 {
  "text": "장부가 칼을 빼었다가 도로 꽂나",
  "author": "한국 속담"
 },
 {
  "text": "재주는 곰이 넘고, 돈은 되놈이 번다",
  "author": "한국 속담"
 },
 {
  "text": "쟁기질 못하는 놈이 소 탓한다",
  "author": "한국 속담"
 },
 {
  "text": "점잖은 개 부뚜막에 오른다",
  "author": "한국 속담"
 },
 {
  "text": "제 코가 석 자나 빠졌다",
  "author": "한국 속담"
 },
 {
  "text": "족제비는 꼬리 보고 잡는다.",
  "author": "한국 속담"
 },
 {
  "text": "종로에서 뺨 맞고 한강에 가서 눈 흘긴다",
  "author": "한국 속담"
 },
 {
  "text": "죽쑤어 개 좋은 일 하였다",
  "author": "한국 속담"
 },
 {
  "text": "중매는 잘 하면 술이 석 잔이고, 못 하면 뺨이 석 대라",
  "author": "한국 속담"
 },
 {
  "text": "중이 제 머리 못 깎는다",
  "author": "한국 속담"
 },
 {
  "text": "쥐구멍에도 볕들 날이 있다",
  "author": "한국 속담"
 },
 {
  "text": "지나가던 개가 웃겠다.",
  "author": "한국 속담"
 },
 {
  "text": "지성이면 감천이다",
  "author": "한국 속담"
 },
 {
  "text": "자라보고 놀란가슴 솥뚜겅보고 놀란다.",
  "author": "한국 속담"
 },
 {
  "text": "점잖은 고양이가 부뚜막에 먼저 올라간다",
  "author": "한국 속담"
 },
 {
  "text": "조용한 고양이가 쥐를 잡는다",
  "author": "한국 속담"
 },
 {
  "text": "찬물도 위아래가 있다",
  "author": "한국 속담"
 },
 {
  "text": "참새가 방앗간을 그대로 지나랴",
  "author": "한국 속담"
 },
 {
  "text": "천 냥 빚도 말로 갚는다",
  "author": "한국 속담"
 },
 {
  "text": "철들자 망령난다",
  "author": "한국 속담"
 },
 {
  "text": "첫 술에 배부르랴",
  "author": "한국 속담"
 },
 {
  "text": "첫딸은 살림 밑천이다",
  "author": "한국 속담"
 },
 {
  "text": "찰찰이 불찰이다",
  "author": "한국 속담"
 },
 {
  "text": "참새가 작아도 알만 잘 깐다",
  "author": "한국 속담"
 },
 {
  "text": "참새 떼 덤비듯",
  "author": "한국 속담"
 },
 {
  "text": "칼로 물 베기",
  "author": "한국 속담"
 },
 {
  "text": "칼을 꺼냈으면 무라도 잘라라",
  "author": "한국 속담"
 },
 {
  "text": "콩 심은 데 콩 나고 팥 심은 데 팥 난다.",
  "author": "한국 속담"
 },
 {
  "text": "콩으로 메주를 쑨다 해도 곧이 안 듣는다",
  "author": "한국 속담"
 },
 {
  "text": "키 크고 싱겁지 않은 사람 없다",
  "author": "한국 속담"
 },
 {
  "text": "코에 걸면 코걸이, 귀에 걸면 귀걸이",
  "author": "한국 속담"
 },
 {
  "text": "털도 안 뜯고 먹겠다 한다",
  "author": "한국 속담"
 },
 {
  "text": "털어서 먼지 안 나는 사람 없다",
  "author": "한국 속담"
 },
 {
  "text": "토끼가 제 방귀에 놀란다",
  "author": "한국 속담"
 },
 {
  "text": "파리 날리다",
  "author": "한국 속담"
 },
 {
  "text": "팔이 안으로 굽지 밖으로 아니 굽는다.",
  "author": "한국 속담"
 },
 {
  "text": "평양 감사도 저 싫으면 그만이다",
  "author": "한국 속담"
 },
 {
  "text": "포수 집 강아지 범 무서운 줄 모른다",
  "author": "한국 속담"
 },
 {
  "text": "품 안에 있어야 자식이라",
  "author": "한국 속담"
 },
 {
  "text": "핑계 없는 무덤 없다",
  "author": "한국 속담"
 },
 {
  "text": "하나를 보면 열을 안다",
  "author": "한국 속담"
 },
 {
  "text": "하늘을 보아야 별을 따지",
  "author": "한국 속담"
 },
 {
  "text": "하던 지랄도 멍석 펴 놓으면 안 한다",
  "author": "한국 속담"
 },
 {
  "text": "하룻강아지 범 무서운 줄 모른다",
  "author": "한국 속담"
 },
 {
  "text": "한 번 실수는 병가의 상사",
  "author": "한국 속담"
 },
 {
  "text": "한 번 엎지른 물은 다시 주워 담지 못한다",
  "author": "한국 속담",
  "note": "한 번 지나간 일은 다시 돌이켜 회복할 수 없다는 말."
 },
 {
  "text": "한 술 밥에 배부르랴",
  "author": "한국 속담"
 },
 {
  "text": "해가 서쪽에서 뜨겠다",
  "author": "한국 속담"
 },
 {
  "text": "헌신짝 버리듯 한다",
  "author": "한국 속담"
 },
 {
  "text": "형만 한 아우 없다",
  "author": "한국 속담"
 },
 {
  "text": "호랑이굴에 가야 호랑이 새끼를 잡는다",
  "author": "한국 속담"
 },
 {
  "text": "호랑이 담배 피우던 시절 이야기다",
  "author": "한국 속담"
 },
 {
  "text": "호랑이도 제 말 하면 온다",
  "author": "한국 속담"
 },
 {
  "text": "호랑이에게 물려가도 정신만 차리면 산다.",
  "author": "한국 속담",
  "note": "큰 변을 당해도 정신만 차리면 버티기 쉽다 라는 뜻."
 },
 {
  "text": "호박이 넝쿨째로 굴러 떨어졌다",
  "author": "한국 속담"
 },
 {
  "text": "혹 떼러 갔다가 혹 붙이고 온다",
  "author": "한국 속담"
 },
 {
  "text": "혼자서 북 치고 장구 친다",
  "author": "한국 속담"
 },
 {
  "text": "홀아비는 이가 서 말, 과부는 은이 서 말이다",
  "author": "한국 속담"
 },
 {
  "text": "화약을 지고 불 속으로 들어간다",
  "author": "한국 속담"
 },
 {
  "text": "효자 집에 효자 난다",
  "author": "한국 속담"
 },
 {
  "text": "호랑이 굴에 들어가야 호랑이 새끼를 잡는다",
  "author": "한국 속담"
 },
 {
  "text": "호랑이에게 물려가도 정신만 바짝 차리면 산다",
  "author": "한국 속담"
 },
 {
  "text": "홍수에 마실 물 없다더라.",
